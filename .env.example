# Nothing here is needed for the default setup:
#   Claude runs on your Claude Code login, and the radio voices are free and local.

# Optional: a Claude API key instead of Claude Code (a little faster). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: ElevenLabs for the most human voices (paid). Leave empty for the free local voices.
ELEVENLABS_API_KEY=

# --- optional ---
# PILOT_BACKEND=cli                   # cli = Claude Code on your login, api = the key above
# CLI_POOL=2                          # Claude Code processes kept open
# PILOT_MODEL=claude-haiku-5-5        # fastest; claude-sonnet-5-5 is richer but slower
# VOICE_ENGINE=local                  # local = free Piper voices, elevenlabs = paid
# ELEVEN_MODEL=eleven_v4_turbo        # expressive, fast. eleven_flash_v2_5 is half the price
# PORT=8787

# Password for the game (a sign-in page appears). Use one when the game is reachable from outside,
# for example through a Cloudflare tunnel. Leave it empty for no sign-in. Restart the game after changing it.
VECTOR_PASSWORD=

# Real traffic (ADS-B) comes from the OpenSky Network. Without an account it allows about 400 requests a day
# (the server asks once a minute while someone plays). A free OpenSky API client raises that to 4000:
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
